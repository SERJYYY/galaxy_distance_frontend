{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "galaxy_distance",
  "version": "0.1.0",
  "identifier": "com.galaxydistance.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "Galaxy Distance",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self' http://10.43.164.209:8000; img-src 'self' http://10.43.164.209:8000 data: blob:; connect-src 'self' http://10.43.164.209:8000; script-src 'self'; style-src 'self' 'unsafe-inline';"
    }
  },

  "plugins": {
    "http": {
      "enabled": true
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
